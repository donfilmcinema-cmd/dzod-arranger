# Встраивает файлы в C++ (массивы байт) без juceaide: -DOUT=<.cpp> -DHDR=<.h> -DNS=<namespace> -DFILES="name=path;..."
set(cpp "#include \"${HDR_NAME}\"\nnamespace ${NS} {\n")
set(h "#pragma once\nnamespace ${NS} {\n")
foreach(pair ${FILES})
  string(REPLACE "=" ";" kv "${pair}")
  list(GET kv 0 name)
  list(GET kv 1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND cpp "static const unsigned char ${name}_data[] = {${bytes}};\nconst void* const ${name} = ${name}_data;\nconst int ${name}Size = ${size};\n")
  string(APPEND h "extern const void* const ${name};\nextern const int ${name}Size;\n")
endforeach()
string(APPEND cpp "}\n")
string(APPEND h "}\n")
file(WRITE "${OUT}" "${cpp}")
file(WRITE "${HDR}" "${h}")
